datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Warehouse {
  id        String   @id @default(uuid())
  name      String
  latitude  Float
  longitude Float
  inventory Inventory[]
}

model Inventory {
  id          String   @id @default(uuid())
  itemName    String
  quantity    Int
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  updatedAt   DateTime  @updatedAt

  @@index([itemName])
}
