datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Supplier {
  id        String       @id @default(uuid())
  name      String
  type      SupplierType
  latitude  Float
  longitude Float
  userId    String      @unique
  inventory Inventory[]
  createdAt DateTime     @default(now())
}

model Inventory {
  id         String   @id @default(uuid())
  itemName   String
  quantity   Int
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  supplierId String
  createdAt  DateTime @default(now())

  @@unique([supplierId, itemName])
  @@index([itemName])
  @@index([supplierId])
}

model Reservation {
  id         String            @id @default(uuid())
  itemName   String
  quantity   Int
  supplierId String
  userId     String
  type       RequestType
  status     ReservationStatus
  expiresAt  DateTime?
  createdAt  DateTime          @default(now())

  delivery Delivery?
}

model Delivery {
  id            String   @id @default(uuid())
  reservationId String   @unique
  supplierId    String
  status        String
  startedAt     DateTime

  reservation Reservation @relation(fields: [reservationId], references: [id])
}

enum SupplierType {
  WAREHOUSE
  PHARMACY
  BLOOD_BANK
  OXYGEN_SUPPLIER
}

enum RequestType {
  PICKUP
  DELIVERY
}

enum ReservationStatus {
  RESERVED
  COMPLETED
  CANCELLED
}
