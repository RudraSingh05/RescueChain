datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Warehouse {
  id        String   @id @default(uuid())
  name      String
  latitude  Float
  longitude Float
  inventory Inventory[]
  createdAt DateTime @default(now())
}


model Inventory {
  id          String    @id @default(uuid())
  itemName    String
  quantity    Int
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  warehouseId String
  createdAt   DateTime  @default(now())
}

